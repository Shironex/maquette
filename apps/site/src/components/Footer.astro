---
import Brand from './Brand.astro';
import { NAV } from '../content/copy';
---

<footer class="footer">
  <div class="wrap row">
    <Brand size={28} wordSize={18} />
    <p class="tag">A desktop studio for real-time 3D web scenes. Everything runs on your machine.</p>
    <span class="grow"></span>
    <nav aria-label="Footer">
      <ul>
        {
          NAV.map(item => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="rights">All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-app);
  }
  .row {
    padding-block: 40px 48px;
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .tag {
    margin: 0;
    font-size: 14px;
    color: var(--text-mute);
  }
  .grow {
    flex: 1;
  }
  ul {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  ul a {
    color: var(--text-dim);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--text);
  }
  .rights {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-mute);
  }
  @media (max-width: 899px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 28px 20px 36px;
    }
    .tag,
    .grow {
      display: none;
    }
    ul a {
      display: inline-block;
      padding-block: 12px;
    }
  }
</style>
