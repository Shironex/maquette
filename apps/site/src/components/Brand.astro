---
interface Props {
  size: number;
  wordSize: number;
}

const { size, wordSize } = Astro.props;
---

<a href="#top" class="brand" aria-label="maquette, back to the top">
  <img src="/icon-64.png" alt="" width={size} height={size} style={`border-radius: ${size / 4}px`} />
  <span style={`font-size: ${wordSize}px`}>maquette</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--text);
  }
  .brand img {
    display: block;
    object-fit: cover;
  }
  .brand span {
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
