---
/**
 * The hero and the six stop tour. On desktop the stage (the 3D island, or a
 * poster per stop without it) pins to the window while one screen tall
 * section per stop scrolls over it; the scroll flies the camera through the
 * bench from stop to stop and the copy travels with the page. After Ship
 * the stage scrolls away with the last section. On phones the stage is a
 * plain hero with one poster and the stops are left to the pipeline section
 * below.
 */
import { Icon } from '@maquette/ui';
import { TOUR } from '../content/copy';
import { STOPS } from '../scene/cameras';
import TourRail from './TourRail.astro';
import TourStop from './TourStop.astro';

const posters = ['stop-0', ...TOUR.map((_, i) => `stop-${i + 1}`)];
const total = TOUR.length;
const side = (index: number) => STOPS[index]?.copy ?? 'left';
---

<section id="top" class="tour" data-tour aria-labelledby="hero-title">
  <div class="stage">
    <div
      class="scene"
      role="img"
      aria-label="A sculptor's workbench at night: a clay island maquette on a plaster plinth, the finished island on a turntable, pencil sketches, tools and a laptop showing Maquette."
    >
      <picture>
        <source
          media="(max-width: 899px)"
          srcset="/scene/posters/hero-mobile.webp"
          width="780"
          height="966"
        />
        <source
          srcset="/scene/posters/stop-0-960.webp 960w, /scene/posters/stop-0-1920.webp 1920w"
          sizes="100vw"
        />
        <img
          class="poster is-shown"
          data-poster="0"
          src="/scene/posters/stop-0-1920.webp"
          width="1920"
          height="912"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      {
        posters.slice(1).map((name, i) => (
          <img
            class="poster later"
            data-poster={i + 1}
            data-src={`/scene/posters/${name}-1920.webp`}
            width="1920"
            height="912"
            alt=""
            decoding="async"
          />
        ))
      }
      <div class="canvas" data-canvas></div>
      <span class="poster-note">Poster frame · live 3D on desktop</span>
    </div>
    <div class="grade" aria-hidden="true"></div>

    <div class="callouts" aria-hidden="true">
      <span class="callout" data-callout="concept"
        ><span class="dot"></span><span class="leg"></span><span class="tag"
          >01 Concept · sketch from the Lab</span
        ></span
      >
      <span class="callout flip" data-callout="model"
        ><span class="dot"></span><span class="leg"></span><span class="tag"
          >03 3D model · clay_island_maquette_v1.glb</span
        ></span
      >
      <span class="callout flip" data-callout="web"
        ><span class="dot"></span><span class="leg"></span><span class="tag"
          >05 Web · KTX2 + meshopt</span
        ></span
      >
    </div>

    <TourRail stops={TOUR} />
  </div>

  <div class="mobile-cta">
    <a class="btn btn-primary" href="#download"
      >Download for Mac<Icon name="download-simple" size={18} /></a
    >
    <a class="btn btn-secondary" href="#pipeline">See the pipeline</a>
  </div>

  <div class="stops">
    <TourStop index={0} id="hero" side="left" labelledby="hero-title" hero>
      <h1 class="display" id="hero-title">Turn concept art into real&#8209;time 3D scenes.</h1>
      <p class="lead hero-lead">
        From a Codex sketch to a compressed GLB in your site repo. Everything runs on your machine.
      </p>
      <div class="actions hero-actions">
        <a class="btn btn-primary" href="#download"
          >Download for Mac<Icon name="download-simple" size={18} /></a
        >
        <a class="btn btn-text see" href="#pipeline"
          >See the pipeline<Icon name="arrow-right" size={18} /></a
        >
      </div>
    </TourStop>
    {
      TOUR.map((stop, i) => (
        <TourStop index={i + 1} id={stop.id} side={side(i + 1)} labelledby={`stop-${stop.id}-title`}>
          <p class="eyebrow">
            Stop {stop.number} of 0{total}
          </p>
          <h2 class="stop-title" id={`stop-${stop.id}-title`}>
            {stop.title}
          </h2>
          <p class="lead">{stop.line}</p>
          {stop.id === 'web' && (
            <p class="numbers">
              <span>
                830 <small>KB</small> to 483 <small>KB</small>
              </span>
              <span>
                about 3 <small>ms</small>
              </span>
            </p>
          )}
          {stop.id === 'ship' && (
            <div class="actions">
              <a class="btn btn-primary" href="#download">
                Download for Mac
                <Icon name="download-simple" size={18} />
              </a>
            </div>
          )}
        </TourStop>
      ))
    }
  </div>
</section>

<script>
  import { startTour } from '../scene/startTour';

  const tour = document.querySelector<HTMLElement>('[data-tour]');
  if (tour) startTour(tour);
</script>

<style>
  .tour {
    --stage: max(100svh, 640px);
    position: relative;
    background: var(--wall);
  }
  /* Pinned while the stop sections scroll over it; it lets go when the
     last one (Ship) reaches the top and leaves with it. */
  .stage {
    position: sticky;
    top: 0;
    height: var(--stage);
    overflow: hidden;
  }
  .stops {
    position: relative;
    margin-top: calc(-1 * var(--stage));
  }
  .scene,
  .canvas,
  .poster,
  .grade {
    position: absolute;
    inset: 0;
  }
  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .poster.is-shown {
    opacity: 1;
  }
  .canvas {
    opacity: 0;
    transition: opacity 700ms ease;
  }
  .is-live .canvas {
    opacity: 1;
  }
  .is-live .poster {
    visibility: hidden;
    transition: visibility 0s 700ms;
  }
  /* The grade: the wall fades in from the header, a soft vignette, and a
     dark floor under the stop rail. The copy carries its own shade. */
  .grade {
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--wall) 0, rgba(26, 25, 23, 0) 150px),
      linear-gradient(0deg, rgba(20, 19, 17, 0.92) 0, rgba(20, 19, 17, 0) 150px),
      radial-gradient(130% 100% at 55% 50%, rgba(0, 0, 0, 0) 55%, rgba(8, 7, 6, 0.55) 100%);
  }

  .display {
    margin: 0;
    max-width: 960px;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero-lead {
    max-width: 400px;
  }
  .actions {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 4px;
  }
  .stop-title {
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .stops .lead {
    color: var(--text);
  }
  .numbers {
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 30px;
    line-height: 36px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .numbers small {
    font-size: 15px;
    color: var(--text-dim);
    letter-spacing: 0;
  }

  .callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .callout {
    position: absolute;
    left: -3.5px;
    top: -3.5px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
  }
  /* Points left, for a label near the right edge. */
  .callout.flip {
    flex-direction: row-reverse;
    translate: calc(-100% + 7px) 0;
  }
  .is-live .callout[data-placed] {
    opacity: 1;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text);
    box-shadow: 0 0 0 3px rgba(233, 229, 220, 0.18);
    flex: none;
  }
  .leg {
    width: 40px;
    height: 1px;
    background: rgba(233, 229, 220, 0.55);
    flex: none;
  }
  .tag {
    background: var(--scrim);
    border: 1px solid rgba(233, 229, 220, 0.14);
    border-radius: 999px;
    padding: 5px 10px;
  }

  .poster-note,
  .mobile-cta {
    display: none;
  }

  @media (max-height: 760px) and (min-width: 900px) {
    .display {
      font-size: 68px;
      line-height: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster,
    .canvas {
      transition: none;
    }
  }

  /* Poster capture: the bare canvas, nothing over it. */
  :global(.capture header),
  :global(.capture) .grade,
  :global(.capture) .callouts,
  :global(.capture) .poster {
    display: none;
  }
  :global(.capture) .canvas {
    transition: none;
  }
  /* Hidden but still laid out: the poster script scrolls to each section. */
  :global(.capture) .stops {
    visibility: hidden;
  }

  /* Phones and narrow windows: the poster version, the hero copy over it. */
  @media (max-width: 899px) {
    .tour {
      display: flex;
      flex-direction: column;
    }
    .stops {
      order: 1;
      margin-top: 0;
    }
    .stage {
      order: 2;
      position: relative;
      height: auto;
      overflow: visible;
    }
    .mobile-cta {
      order: 3;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 24px 20px 32px;
      background: var(--bg-app);
    }
    .display {
      font-size: 44px;
      line-height: 46px;
    }
    .hero-lead {
      max-width: none;
      font-size: 16px;
      line-height: 25px;
    }
    .hero-actions {
      display: none;
    }
    .scene {
      position: relative;
      margin-top: -12px;
      aspect-ratio: 390 / 483;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 90px);
      mask-image: linear-gradient(180deg, transparent 0, #000 90px);
    }
    .poster-note {
      display: block;
      position: absolute;
      left: 20px;
      bottom: 16px;
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 15px;
      color: var(--text);
      background: var(--scrim);
      border: 1px solid rgba(233, 229, 220, 0.14);
      border-radius: 999px;
      padding: 5px 10px;
    }
    .poster.later,
    .canvas,
    .grade,
    .callouts {
      display: none;
    }
  }
</style>
