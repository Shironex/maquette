---
import { Icon } from '@maquette/ui';

interface Props {
  /** The page's Markdown twin. */
  href: string;
}

const { href } = Astro.props;
---

<span class="actions">
  <button type="button" class="act" data-copy-md={href}>
    <Icon name="copy" size={14} />
    <span data-label>Copy page as Markdown</span>
  </button>
  <a class="act" {href}>
    <Icon name="file-text" size={14} />
    View as .md
  </a>
  <span class="sr-only" role="status" data-status></span>
</span>

<script>
  const FLASH_MS = 2000;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-md]')) {
    const label = button.querySelector<HTMLElement>('[data-label]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-status]');
    const say = (text: string) => {
      if (label) label.textContent = text;
      if (status) status.textContent = text;
    };
    button.addEventListener('click', async () => {
      const idle = 'Copy page as Markdown';
      try {
        const response = await fetch(button.dataset.copyMd ?? '');
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        say('Copied');
      } catch {
        say('Could not copy');
      }
      setTimeout(() => say(idle), FLASH_MS);
    });
  }
</script>

<style>
  .actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--clay-text);
    text-decoration: none;
    cursor: pointer;
  }
  .act:hover {
    color: var(--focus);
  }
</style>
