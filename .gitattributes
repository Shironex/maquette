# Let git normalize line endings (LF in the repo, native on checkout).
* text=auto

# rustfmt.toml pins `newline_style = "Unix"`, so a CRLF checkout of Rust sources
# would fail `cargo fmt --check` on Windows for changes nobody made.
*.rs text eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.icns binary
*.ico binary
*.woff2 binary
*.webp binary
*.glb binary
*.wasm binary

# Starter and thumbnail scripts are embedded with include_str!, so every machine writes the
# same bytes into new projects.
crates/maquette-core/starter/** text eol=lf
crates/maquette-core/src/thumbs/*.py text eol=lf

# Recipe file fixtures are compared byte for byte.
crates/maquette-model/src/recipes/fixtures/*.json text eol=lf

# A workspace as Maquette 0.7.1 wrote it: its files are loaded as they are.
crates/maquette-core/src/providers/tests/ids/older_workspace/** text eol=lf
